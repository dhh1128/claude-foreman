#!/usr/bin/env python3
"""`foreman` is zamu's name before 2026-10-12. Kept for one release so sessions and worker
prompts that still say `foreman` keep working; it runs `zamu` with the same arguments."""

import os
import sys
from pathlib import Path

zamu = Path(__file__).resolve().parent / "zamu"
os.execv(sys.executable, [sys.executable, str(zamu), *sys.argv[1:]])
