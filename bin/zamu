#!/usr/bin/env python3
"""zamu -- hold a cross-repo plan, launch worker sessions when dependencies clear, watch
them, and escalate. A thin entry point; everything lives in the `zamu` package beside `bin/`.

    zamu board            what a waking PM reads
    zamu pulse            check oracles and workers, escalate decisions, print the board
    zamu launch --ready   what would launch now (dry run; --go executes)
    zamu report <id> <running|review|done|stuck> "<line>"   (workers)
    zamu --help           everything else

Tests: uv run --no-project --python 3.11 --with pytest python -m pytest tests -q
"""

import sys

if sys.version_info < (3, 11):
    sys.exit("zamu needs Python 3.11 or later (it reads TOML with tomllib).")

from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from zamu.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
